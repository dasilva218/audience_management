// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enumérations ---

enum RequestStatus {
  PENDING // En attente de traitement
  PROCESSING // En cours d'examen
  SCHEDULED // Audience programmée
  REJECTED // Demande refusée
  COMPLETED // Audience effectuée
}

enum UserRole {
  AGENT
  ADMIN
}

// --- Modèles de l'Application ---

model Ministry {
  id_ministry String   @id @default(cuid())
  name        String   @unique // ex: "Ministère de l'Économie Numérique"
  slug        String   @unique // ex: "ministere-economie-numerique"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users    User[] // Les agents/admins rattachés au ministère
  requests AudienceRequest[] // Les demandes reçues par ce ministère
}

model AudienceRequest {
  id_audience  String @id @default(cuid())
  trackingCode String @unique // Code généré type "AUD-2024-XXXX"

  // Informations du Demandeur (Public)
  fullName String
  email    String
  phone    String
  subject  String  @db.Text
  message  String? @db.Text

  // Documents (Stockage des URLs/Chemins)
  identityDocUrl   String // URL du PDF/Image de la pièce d'identité
  requestLetterUrl String // URL du PDF de la demande officielle

  // Suivi interne
  status      RequestStatus @default(PENDING)
  adminNote   String?       @db.Text // Note interne des agents
  scheduledAt DateTime? // Date et heure de l'audience si acceptée

  // Relations
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id_ministry])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingCode])
  @@index([ministryId])
}

// --- Modèles Better Auth (Adaptés) ---

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Champ personnalisé : Rôle et appartenance
  role       UserRole  @default(AGENT) // admin, agent
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id_ministry])

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}
